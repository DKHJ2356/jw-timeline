// Cloudflare Workers (static assets only): serves the `next build` export in ./out.
// `name` must match the Worker's name in the Cloudflare dashboard.
{
  "name": "jw-timeline",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
